{
  "license": "GPL-3.0-or-later",
  "type": "streamer",
  "label": "Streamer",
  "badge": {
    "label": "Streamer",
    "class": "mode-stream",
    "oklch": "0.77 0.06 50"
  },
  "deploy_order": 2,
  "version": "0.9.0",
  "runtime": "docker",
  "adapts_input": true,
  "image": "media",
  "resources": {
    "cores": 4,
    "memory": 1024,
    "pin": false
  },
  "description": "Encodeur/streamer : encode une entrée vidéo (+ audio 8ch) et diffuse vers plusieurs destinations UDP/SRT/WebRTC (un seul encode, fan-out). Édité sur la page I/O (onglet Streams).",
  "nav": {
    "section": "streams",
    "label": "Streams",
    "route": "/io",
    "order": 10
  },
  "script_template": "script.py",
  "ui": {
    "control_html": "control.html",
    "control_js": "control.js",
    "control_css": "control.css"
  },
  "deploy_defaults": {
    "shm_name": "mxl_mix",
    "audio_shm": null,
    "hot_input": false,
    "av_offset_ms": 0,
    "video": {
      "codec": "h264",
      "bitrate": "4M",
      "preset": "ultrafast",
      "gop": 25,
      "width": 0,
      "height": 0,
      "fps": 25
    },
    "audio": {
      "enabled": false,
      "codec": "aac",
      "bitrate": "128k",
      "tracks": []
    },
    "destinations": []
  },
  "wiring": {
    "produces": [],
    "consumes": [
      {
        "essence": "video",
        "state_field": "shm_name",
        "label": "Vidéo"
      },
      {
        "essence": "audio",
        "state_field": "audio_shm",
        "label": "Audio"
      }
    ],
    "mode": "hot-wire",
    "state_endpoint": "/state"
  },
  "control": {
    "endpoints": [
      "/input",
      "/audiomap"
    ]
  }
}
